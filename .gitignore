# Godot 4.8
# https://docs.godotengine.org/en/stable/tutorials/best_practices/version_control_systems.html

# Editor cache, imported binaries, and shader cache.
.godot/

# Android Gradle project generated by the exporter.
# Leading slash: only the project-root folder.
/android/
.nomedia

# Secrets live here as of Godot 4.1. Commit export_presets.cfg.
export_credentials.cfg
export.cfg

# Binary translations generated from CSV files.
*.translation

# C# / .NET build output (Godot 4.2+ also writes temporary assemblies).
.mono/
data_*/
mono_crash.*.json
~*.dll

# Temporary files.
*.tmp

# Exported game builds.
/build/
/exports/
*.apk
*.aab

# OS junk.
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
